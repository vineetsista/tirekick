-events:none;background-image:repeating-linear-gradient(to right, rgba(230,237,243,0.04) 0 1px, transparent 1px 40px),repeating-linear-gradient(to bottom, rgba(230,237,243,0.04) 0 1px, transparent 1px 40px)"></span><a href="#vf_odo_01" title="Odometer display reading 128,540" style="position:absolute;left:34.000%;top:44.000%;width:30.000%;height:12.000%;border:2px solid var(--tk-sev-info);background:color-mix(in srgb, var(--tk-sev-info) 8%, transparent);border-radius:0;display:block"><span aria-hidden="true" style="position:absolute;width:9px;height:9px;top:-2px;left:-2px;border-top:2px solid var(--tk-sev-info);border-left:2px solid var(--tk-sev-info)"></span><span aria-hidden="true" style="position:absolute;width:9px;height:9px;top:-2px;right:-2px;border-top:2px solid var(--tk-sev-info);border-right:2px solid var(--tk-sev-info)"></span><span aria-hidden="true" style="position:absolute;width:9px;height:9px;bottom:-2px;left:-2px;border-bottom:2px solid var(--tk-sev-info);border-left:2px solid var(--tk-sev-info)"></span><span aria-hidden="true" style="position:absolute;width:9px;height:9px;bottom:-2px;right:-2px;border-bottom:2px solid var(--tk-sev-info);border-right:2px solid var(--tk-sev-info)"></span><span style="position:absolute;top:100%;margin-top:4px;right:-2px;background:var(--tk-sev-info);color:#0a0c0e;font-size:10px;letter-spacing:0.12em;padding:2px 6px;white-space:nowrap;line-height:1.6">ODOMETER READING / INFO / 0.91</span></a><span style="position:absolute;top:10px;right:10px;background:var(--tk-locked);color:#0a0c0e;font-size:10px;letter-spacing:0.14em;padding:3px 8px;line-height:1.6">SYNTHETIC FIXTURE</span></div></figure><div style="display:flex;justify-content:space-between;gap:10px;margin-top:8px;font-size:11px"><span class="mono-label">photo_06 / odometer</span><span class="muted">1 region flagged</span></div></div><div><figure style="margin:0"><div style="position:relative;background:#000;border:1px solid var(--tk-line);line-height:0"><img src="/f/demo-01/photo_07.jpg" alt="tire - photo_07" style="width:100%;height:auto;display:block;filter:saturate(0.85) brightness(0.92)"/><span aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;background-image:repeating-linear-gradient(to right, rgba(230,237,243,0.04) 0 1px, transparent 1px 40px),repeating-linear-gradient(to bottom, rgba(230,237,243,0.04) 0 1px, transparent 1px 40px)"></span><a href="#vf_tire_01" title="Tread block area on the front left tire" style="position:absolute;left:30.000%;top:30.000%;width:36.000%;height:36.000%;border:2px solid var(--tk-sev-minor);background:color-mix(in srgb, var(--tk-sev-minor) 8%, transparent);border-radius:0;display:block"><span aria-hidden="true" style="position:absolute;width:9px;height:9px;top:-2px;left:-2px;border-top:2px solid var(--tk-sev-minor);border-left:2px solid var(--tk-sev-minor)"></span><span aria-hidden="true" style="position:absolute;width:9px;height:9px;top:-2px;right:-2px;border-top:2px solid var(--tk-sev-minor);border-right:2px solid var(--tk-sev-minor)"></span><span aria-hidden="true" style="position:absolute;width:9px;height:9px;bottom:-2px;left:-2px;border-bottom:2px solid var(--tk-sev-minor);border-left:2px solid var(--tk-sev-minor)"></span><span aria-hidden="true" style="position:absolute;width:9px;height:9px;bottom:-2px;right:-2px;border-bottom:2px solid var(--tk-sev-minor);border-right:2px solid var(--tk-sev-minor)"></span><span style="position:absolute;top:100%;margin-top:4px;right:-2px;background:var(--tk-sev-minor);color:#0a0c0e;font-size:10px;letter-spacing:0.12em;padding:2px 6px;white-space:nowrap;line-height:1.6">TIRE TREAD ESTIMATE / MINOR / 0.58</span></a><span style="position:absolute;top:10px;right:10px;background:var(--tk-locked);color:#0a0c0e;font-size:10px;letter-spacing:0.14em;padding:3px 8px;line-height:1.6">SYNTHETIC FIXTURE</span></div></figure><div style="display:flex;justify-content:space-between;gap:10px;margin-top:8px;font-size:11px"><span class="mono-label">photo_07 / tire</span><span class="muted">1 region flagged</span></div></div><div><figure style="margin:0"><div style="position:relative;background:#000;border:1px solid var(--tk-line);line-height:0"><img src="/f/demo-01/photo_08.jpg" alt="engine_bay - photo_08" style="width:100%;height:auto;display:block;filter:saturate(0.85) brightness(0.92)"/><span aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;background-image:repeating-linear-gradient(to right, rgba(230,237,243,0.04) 0 1px, transparent 1px 40px),repeating-linear-gradient(to bottom, rgba(230,237,243,0.04) 0 1px, transparent 1px 40px)"></span><a href="#vf_bay_01" title="Residue on engine bay surface" style="position:absolute;left:16.000%;top:28.000%;width:22.000%;height:16.000%;border:2px solid var(--tk-sev-minor);background:color-mix(in srgb, var(--tk-sev-minor) 8%, transparent);border-radius:0;display:block"><span aria-hidden="true" style="position:absolute;width:9px;height:9px;top:-2px;left:-2px;border-top:2px solid var(--tk-sev-minor);border-left:2px solid var(--tk-sev-minor)"></span><span aria-hidden="true" style="position:absolute;width:9px;height:9px;top:-2px;right:-2px;border-top:2px solid var(--tk-sev-minor);border-right:2px solid var(--tk-sev-minor)"></span><span aria-hidden="true" style="position:absolute;width:9px;height:9px;bottom:-2px;left:-2px;border-bottom:2px solid var(--tk-sev-minor);border-left:2px solid var(--tk-sev-minor)"></span><span aria-hidden="true" style="position:absolute;width:9px;height:9px;bottom:-2px;right:-2px;border-bottom:2px solid var(--tk-sev-minor);border-right:2px solid var(--tk-sev-minor)"></span><span style="position:absolute;top:100%;margin-top:4px;left:-2px;background:var(--tk-sev-minor);color:#0a0c0e;font-size:10px;letter-spacing:0.12em;padding:2px 6px;white-space:nowrap;line-height:1.6">FLUID LEAK INDICATOR / MINOR / 0.61</span></a><a href="#ref_vf_bay_02" title="Wet area on and around the front hub" style="position:absolute;left:60.000%;top:58.000%;width:24.000%;height:20.000%;border:2px solid var(--tk-locked);background:color-mix(in srgb, var(--tk-locked) 8%, transparent);border-radius:0;display:block"><span aria-hidden="true" style="position:absolute;width:9px;height:9px;top:-2px;left:-2px;border-top:2px solid var(--tk-locked);border-left:2px solid var(--tk-locked)"></span><span aria-hidden="true" style="position:absolute;width:9px;height:9px;top:-2px;right:-2px;border-top:2px solid var(--tk-locked);border-right:2px solid var(--tk-locked)"></span><span aria-hidden="true" style="position:absolute;width:9px;height:9px;bottom:-2px;left:-2px;border-bottom:2px solid var(--tk-locked);border-left:2px solid var(--tk-locked)"></span><span aria-hidden="true" style="position:absolute;width:9px;height:9px;bottom:-2px;right:-2px;border-bottom:2px solid var(--tk-locked);border-right:2px solid var(--tk-locked)"></span><span style="position:absolute;top:100%;margin-top:4px;right:-2px;background:var(--tk-locked);color:#0a0c0e;font-size:10px;letter-spacing:0.12em;padding:2px 6px;white-space:nowrap;line-height:1.6">BRAKES / MECHANIC REQUIRED</span></a><span style="position:absolute;top:10px;right:10px;background:var(--tk-locked);color:#0a0c0e;font-size:10px;letter-spacing:0.14em;padding:3px 8px;line-height:1.6">SYNTHETIC FIXTURE</span></div></figure><div style="display:flex;justify-content:space-between;gap:10px;margin-top:8px;font-size:11px"><span class="mono-label">photo_08 / engine_bay</span><span class="muted">2 regions flagged</span></div></div></div></section><section class="section"><div class="section-label">Findings (14)</div><div style="display:grid;gap:16px"><div id="vf_rust_01" class="panel" style="border-left:3px solid var(--tk-sev-major);scroll-margin-top:24px"><div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center"><div><span style="font-size:10px;letter-spacing:0.14em;background:var(--tk-sev-major);color:#0a0c0e;padding:2px 7px">MAJOR</span><span class="mono-label" style="margin-left:10px">rust corrosion / vision</span></div><span style="display:inline-flex;align-items:center;gap:8px" title="CONF 0.72"><span class="mono-label" style="letter-spacing:0.12em">CONF</span><span style="display:inline-flex;gap:2px" aria-hidden="true"><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span></span><span style="font-size:13px;color:var(--tk-sev-major)">0.72</span></span></div><div style="font-size:16px;margin:14px 0 8px">Corrosion visible along driver-side rocker panel</div><div class="prose" style="font-size:13px;margin-bottom:14px">A band of corrosion is visible along the lower rocker panel, roughly one third of the panel length. The texture in this image is consistent with surface corrosion rather than perforation, but whether the metal is compromised underneath cannot be determined from a photograph.</div><div class="prose muted" style="font-size:12px;margin-bottom:14px"><strong style="font-weight:500">Why this confidence:</strong> The region is well lit and unobstructed. Confidence is held below 0.8 because surface corrosion and early perforation look similar at this resolution.</div><div style="border-top:1px solid var(--tk-line);padding-top:12px"><div class="mono-label">Evidence</div><ul style="margin:8px 0 0;padding-left:18px;font-size:12px"><li class="muted" style="margin-bottom:4px"><span style="color:var(--tk-text)">photo_01</span> - Corrosion band along the lower rocker panel <span style="color:var(--tk-unknown)">[0.08, 0.62, 0.34, 0.14]</span></li></ul></div><div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--tk-line);font-size:12px" class="prose"><div style="margin-bottom:6px"><span class="mono-label">Est. repair</span> <span style="color:var(--tk-sev-major)">$600 - $900</span></div><div style="margin-bottom:6px"><span class="mono-label">Ask the seller</span> How long has the rust on the rocker panel been there, and has any bodywork been done to it?</div><div><span class="mono-label">Ask a mechanic</span> Ask a mechanic to probe the rocker panel and inspect the seam from underneath on a lift.</div></div></div><div id="vf_dent_01" class="panel" style="border-left:3px solid var(--tk-sev-minor);scroll-margin-top:24px"><div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center"><div><span style="font-size:10px;letter-spacing:0.14em;background:var(--tk-sev-minor);color:#0a0c0e;padding:2px 7px">MINOR</span><span class="mono-label" style="margin-left:10px">exterior damage / vision</span></div><span style="display:inline-flex;align-items:center;gap:8px" title="CONF 0.64"><span class="mono-label" style="letter-spacing:0.12em">CONF</span><span style="display:inline-flex;gap:2px" aria-hidden="true"><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span></span><span style="font-size:13px;color:var(--tk-sev-minor)">0.64</span></span></div><div style="font-size:16px;margin:14px 0 8px">Deformation on rear quarter panel</div><div class="prose" style="font-size:13px;margin-bottom:14px">A shallow deformation is visible on the rear quarter panel above the wheel arch. No paint fracture is visible at this resolution.</div><div class="prose muted" style="font-size:12px;margin-bottom:14px"><strong style="font-weight:500">Why this confidence:</strong> The shading pattern is consistent with a dent, but a reflection or a shadow can produce a similar pattern. Confidence held low.</div><div style="border-top:1px solid var(--tk-line);padding-top:12px"><div class="mono-label">Evidence</div><ul style="margin:8px 0 0;padding-left:18px;font-size:12px"><li class="muted" style="margin-bottom:4px"><span style="color:var(--tk-text)">photo_03</span> - Deformation above the rear wheel arch <span style="color:var(--tk-unknown)">[0.55, 0.40, 0.20, 0.18]</span></li></ul></div><div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--tk-line);font-size:12px" class="prose"><div style="margin-bottom:6px"><span class="mono-label">Ask the seller</span> Do you know how the dent on the rear quarter happened?</div></div></div><div id="vf_wear_01" class="panel" style="border-left:3px solid var(--tk-sev-minor);scroll-margin-top:24px"><div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center"><div><span style="font-size:10px;letter-spacing:0.14em;background:var(--tk-sev-minor);color:#0a0c0e;padding:2px 7px">MINOR</span><span class="mono-label" style="margin-left:10px">interior wear / vision</span></div><span style="display:inline-flex;align-items:center;gap:8px" title="CONF 0.78"><span class="mono-label" style="letter-spacing:0.12em">CONF</span><span style="display:inline-flex;gap:2px" aria-hidden="true"><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span></span><span style="font-size:13px;color:var(--tk-sev-minor)">0.78</span></span></div><div style="font-size:16px;margin:14px 0 8px">Driver seat bolster wear</div><div class="prose" style="font-size:13px;margin-bottom:14px">Wear is visible on the outer driver seat bolster, consistent with regular entry and exit over time. No tearing is visible.</div><div class="prose muted" style="font-size:12px;margin-bottom:14px"><strong style="font-weight:500">Why this confidence:</strong> Bolster wear is one of the more reliably visible interior signals in a well-lit cabin photo.</div><div style="border-top:1px solid var(--tk-line);padding-top:12px"><div class="mono-label">Evidence</div><ul style="margin:8px 0 0;padding-left:18px;font-size:12px"><li class="muted" style="margin-bottom:4px"><span style="color:var(--tk-text)">photo_04</span> - Outer driver seat bolster <span style="color:var(--tk-unknown)">[0.20, 0.45, 0.24, 0.22]</span></li></ul></div></div><div id="vf_lamp_01" class="panel" style="border-left:3px solid var(--tk-sev-major);scroll-margin-top:24px"><div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center"><div><span style="font-size:10px;letter-spacing:0.14em;background:var(--tk-sev-major);color:#0a0c0e;padding:2px 7px">MAJOR</span><span class="mono-label" style="margin-left:10px">dash warning light / vision</span></div><span style="display:inline-flex;align-items:center;gap:8px" title="CONF 0.83"><span class="mono-label" style="letter-spacing:0.12em">CONF</span><span style="display:inline-flex;gap:2px" aria-hidden="true"><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span></span><span style="font-size:13px;color:var(--tk-sev-major)">0.83</span></span></div><div style="font-size:16px;margin:14px 0 8px">Check-engine lamp illuminated in the instrument cluster</div><div class="prose" style="font-size:13px;margin-bottom:14px">A check-engine lamp is illuminated in the cluster in this photograph. What triggered it cannot be determined without reading the fault codes with a scan tool.</div><div class="prose muted" style="font-size:12px;margin-bottom:14px"><strong style="font-weight:500">Why this confidence:</strong> The lamp shape and position are clearly legible. The reading is about the photograph, not about the vehicle&#x27;s condition.</div><div style="border-top:1px solid var(--tk-line);padding-top:12px"><div class="mono-label">Evidence</div><ul style="margin:8px 0 0;padding-left:18px;font-size:12px"><li class="muted" style="margin-bottom:4px"><span style="color:var(--tk-text)">photo_05</span> - Illuminated lamp in the instrument cluster <span style="color:var(--tk-unknown)">[0.62, 0.30, 0.10, 0.12]</span></li></ul></div><div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--tk-line);font-size:12px" class="prose"><div style="margin-bottom:6px"><span class="mono-label">Ask the seller</span> The check-engine light is on in your photo. What code is it throwing, and how long has it been on?</div><div><span class="mono-label">Ask a mechanic</span> Have the fault codes read with a scan tool before agreeing on a price. A $20 code read can be the difference between a sensor and a catalytic converter.</div></div></div><div id="vf_odo_01" class="panel" style="border-left:3px solid var(--tk-sev-info);scroll-margin-top:24px"><div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center"><div><span style="font-size:10px;letter-spacing:0.14em;background:var(--tk-sev-info);color:#0a0c0e;padding:2px 7px">INFO</span><span class="mono-label" style="margin-left:10px">odometer reading / vision</span></div><span style="display:inline-flex;align-items:center;gap:8px" title="CONF 0.91"><span class="mono-label" style="letter-spacing:0.12em">CONF</span><span style="display:inline-flex;gap:2px" aria-hidden="true"><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span></span><span style="font-size:13px;color:var(--tk-sev-info)">0.91</span></span></div><div style="font-size:16px;margin:14px 0 8px">Odometer reads 128,540 miles</div><div class="prose" style="font-size:13px;margin-bottom:14px">The odometer display reads 128,540 miles in this photograph. This matches the mileage stated by the seller. A photograph of an odometer is evidence of what the display showed when the photo was taken, and nothing more.</div><div class="prose muted" style="font-size:12px;margin-bottom:14px"><strong style="font-weight:500">Why this confidence:</strong> All digits are legible and unobstructed. Confidence reflects the legibility of the display, not the truthfulness of the reading.</div><div style="border-top:1px solid var(--tk-line);padding-top:12px"><div class="mono-label">Evidence</div><ul style="margin:8px 0 0;padding-left:18px;font-size:12px"><li class="muted" style="margin-bottom:4px"><span style="color:var(--tk-text)">photo_06</span> - Odometer display reading 128,540 <span style="color:var(--tk-unknown)">[0.34, 0.44, 0.30, 0.12]</span></li></ul></div><div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--tk-line);font-size:12px" class="prose"><div style="margin-bottom:6px"><span class="mono-label">Ask the seller</span> Can you show me the title and any service records so I can check the mileage history?</div></div></div><div id="vf_tire_01" class="panel" style="border-left:3px solid var(--tk-sev-minor);scroll-margin-top:24px"><div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center"><div><span style="font-size:10px;letter-spacing:0.14em;background:var(--tk-sev-minor);color:#0a0c0e;padding:2px 7px">MINOR</span><span class="mono-label" style="margin-left:10px">tire tread estimate / vision</span></div><span style="display:inline-flex;align-items:center;gap:8px" title="CONF 0.58"><span class="mono-label" style="letter-spacing:0.12em">CONF</span><span style="display:inline-flex;gap:2px" aria-hidden="true"><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span></span><span style="font-size:13px;color:var(--tk-sev-minor)">0.58</span></span></div><div style="font-size:16px;margin:14px 0 8px">Front left tread appears low</div><div class="prose" style="font-size:13px;margin-bottom:14px">Tread depth on the front left tire appears low relative to the tread block spacing visible in this image. Tread depth from a photograph is an estimate; a tread gauge costs a few dollars and settles it in seconds.</div><div class="prose muted" style="font-size:12px;margin-bottom:14px"><strong style="font-weight:500">Why this confidence:</strong> Tread depth from a single photograph at this angle is unreliable. Confidence is low on purpose and this finding should be treated as a prompt to measure, not a measurement.</div><div style="border-top:1px solid var(--tk-line);padding-top:12px"><div class="mono-label">Evidence</div><ul style="margin:8px 0 0;padding-left:18px;font-size:12px"><li class="muted" style="margin-bottom:4px"><span style="color:var(--tk-text)">photo_07</span> - Tread block area on the front left tire <span style="color:var(--tk-unknown)">[0.30, 0.30, 0.36, 0.36]</span></li></ul></div><div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--tk-line);font-size:12px" class="prose"><div style="margin-bottom:6px"><span class="mono-label">Est. repair</span> <span style="color:var(--tk-sev-minor)">$380 - $620</span></div><div style="margin-bottom:6px"><span class="mono-label">Ask the seller</span> How old are the tires, and were they all replaced at the same time?</div><div><span class="mono-label">Ask a mechanic</span> Measure tread depth on all four tires with a gauge and check for uneven wear that would suggest an alignment problem.</div></div></div><div id="vf_bay_01" class="panel" style="border-left:3px solid var(--tk-sev-minor);scroll-margin-top:24px"><div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center"><div><span style="font-size:10px;letter-spacing:0.14em;background:var(--tk-sev-minor);color:#0a0c0e;padding:2px 7px">MINOR</span><span class="mono-label" style="margin-left:10px">fluid leak indicator / vision</span></div><span style="display:inline-flex;align-items:center;gap:8px" title="CONF 0.61"><span class="mono-label" style="letter-spacing:0.12em">CONF</span><span style="display:inline-flex;gap:2px" aria-hidden="true"><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span><span style="width:7px;height:12px;background:var(--tk-line)"></span></span><span style="font-size:13px;color:var(--tk-sev-minor)">0.61</span></span></div><div style="font-size:16px;margin:14px 0 8px">Residue visible on engine bay surface</div><div class="prose" style="font-size:13px;margin-bottom:14px">A dark residue is visible on a surface in the engine bay. Whether this is an active leak, a past leak that was cleaned, or spilled fluid from a top-up cannot be determined from a photograph.</div><div class="prose muted" style="font-size:12px;margin-bottom:14px"><strong style="font-weight:500">Why this confidence:</strong> The residue is visible but its source is not traceable in a single still image.</div><div style="border-top:1px solid var(--tk-line);padding-top:12px"><div class="mono-label">Evidence</div><ul style="margin:8px 0 0;padding-left:18px;font-size:12px"><li class="muted" style="margin-bottom:4px"><span style="color:var(--tk-text)">photo_08</span> - Residue on engine bay surface <span style="color:var(--tk-unknown)">[0.16, 0.28, 0.22, 0.16]</span></li></ul></div><div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--tk-line);font-size:12px" class="prose"><div style="margin-bottom:6px"><span class="mono-label">Ask the seller</span> Is the engine losing any fluid? When were the fluids last topped up or changed?</div><div><span class="mono-label">Ask a mechanic</span> Ask a mechanic to identify the fluid and find its source.</div></div></div><div id="recall_25V422000" class="panel" style="border-left:3px solid var(--tk-sev-major);scroll-margin-top:24px"><div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center"><div><span style="font-size:10px;letter-spacing:0.14em;background:var(--tk-sev-major);color:#0a0c0e;padding:2px 7px">MAJOR</span><span class="mono-label" style="margin-left:10px">open recall / data</span></div><span style="display:inline-flex;align-items:center;gap:8px" title="CONF 1.00"><span class="mono-label" style="letter-spacing:0.12em">CONF</span><span style="display:inline-flex;gap:2px" aria-hidden="true"><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span></span><span style="font-size:13px;color:var(--tk-sev-major)">1.00</span></span></div><div style="font-size:16px;margin:14px 0 8px">Recall 25V422000: POWER TRAIN:DRIVELINE:DRIVESHAFT</div><div class="prose" style="font-size:13px;margin-bottom:14px">Honda (American Honda Motor Co.) is recalling certain 2013 Honda Accord vehicles equipped with a 4-cylinder engine and a continuously-variable transmission. The affected vehicles were originally sold, or ever registered, in Connecticut, Delaware, District of Columbia, Illinois, Indiana, Iowa, Kentucky, Maine, Maryland, Massachusetts, Michigan, Minnesota, Missouri, New Hampshire, New Jersey, New York, Ohio, Pennsylvania, Rhode Island, Vermont, Virginia, West Virginia, and Wisconsin. The driveshaft may corrode and break, due to damage from road salt or other contaminants. NHTSA states the consequence: A broken driveshaft can result in a loss of drive power, or a vehicle rollaway when the vehicle is in park without the parking brake applied. Both scenarios can increase the risk of a crash or injury. This campaign is on record for this model year. TIREKICK cannot tell whether it was ever carried out on this particular vehicle - NHTSA does not publish per-VIN repair status - so treat it as a question to settle, not as a defect found. Any dealer will check by VIN and perform outstanding recall work free.</div><div class="prose muted" style="font-size:12px;margin-bottom:14px"><strong style="font-weight:500">Why this confidence:</strong> Transcribed from the NHTSA recall record, not judged by a model. The certainty is that this campaign exists and covers this model year. Whether it is outstanding on this car is not something we know.</div><div style="border-top:1px solid var(--tk-line);padding-top:12px"><div class="mono-label">Evidence</div><ul style="margin:8px 0 0;padding-left:18px;font-size:12px"><li class="muted" style="margin-bottom:4px"><span style="color:var(--tk-text)">NHTSA Safety Recalls</span> / 25V422000 - NHTSA campaign 25V422000 - POWER TRAIN:DRIVELINE:DRIVESHAFT <span style="color:var(--tk-unknown)">(2026-07-26T23:31:29Z)</span></li></ul></div><div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--tk-line);font-size:12px" class="prose"><div style="margin-bottom:6px"><span class="mono-label">Ask the seller</span> Recall 25V422000 covers this model year. Has it been done on this car, and do you have the dealer paperwork?</div></div></div><div id="recall_23V858000" class="panel" style="border-left:3px solid var(--tk-sev-major);scroll-margin-top:24px"><div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center"><div><span style="font-size:10px;letter-spacing:0.14em;background:var(--tk-sev-major);color:#0a0c0e;padding:2px 7px">MAJOR</span><span class="mono-label" style="margin-left:10px">open recall / data</span></div><span style="display:inline-flex;align-items:center;gap:8px" title="CONF 1.00"><span class="mono-label" style="letter-spacing:0.12em">CONF</span><span style="display:inline-flex;gap:2px" aria-hidden="true"><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span></span><span style="font-size:13px;color:var(--tk-sev-major)">1.00</span></span></div><div style="font-size:16px;margin:14px 0 8px">Recall 23V858000: FUEL SYSTEM, GASOLINE:DELIVERY:FUEL PUMP</div><div class="prose" style="font-size:13px;margin-bottom:14px">Honda (American Honda Motor Co.) is recalling certain 2013-2023 Honda Accord, Civic Coupe, Civic Sedan, Civic Hatchback, Civic Type R, CR-V, HR-V, Ridgeline, Odyssey, Acura ILX, MDX, MDX Hybrid, RDX, RLX, TLX, 2019-2022 Honda Insight, Passport, 2020 Honda CR-V Hybrid, 2018-2019 Honda Clarity PHEV, Fit, and 2015-2020 Honda Accord Hybrid, Pilot, Acura NSX vehicles.  The fuel pump inside the fuel tank may fail. NHTSA states the consequence: Fuel pump failure can cause an engine stall while driving, increasing the risk of a crash. This campaign is on record for this model year. TIREKICK cannot tell whether it was ever carried out on this particular vehicle - NHTSA does not publish per-VIN repair status - so treat it as a question to settle, not as a defect found. Any dealer will check by VIN and perform outstanding recall work free.</div><div class="prose muted" style="font-size:12px;margin-bottom:14px"><strong style="font-weight:500">Why this confidence:</strong> Transcribed from the NHTSA recall record, not judged by a model. The certainty is that this campaign exists and covers this model year. Whether it is outstanding on this car is not something we know.</div><div style="border-top:1px solid var(--tk-line);padding-top:12px"><div class="mono-label">Evidence</div><ul style="margin:8px 0 0;padding-left:18px;font-size:12px"><li class="muted" style="margin-bottom:4px"><span style="color:var(--tk-text)">NHTSA Safety Recalls</span> / 23V858000 - NHTSA campaign 23V858000 - FUEL SYSTEM, GASOLINE:DELIVERY:FUEL PUMP <span style="color:var(--tk-unknown)">(2026-07-26T23:31:29Z)</span></li></ul></div><div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--tk-line);font-size:12px" class="prose"><div style="margin-bottom:6px"><span class="mono-label">Ask the seller</span> Recall 23V858000 covers this model year. Has it been done on this car, and do you have the dealer paperwork?</div></div></div><div id="recall_20V769000" class="panel" style="border-left:3px solid var(--tk-sev-major);scroll-margin-top:24px"><div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center"><div><span style="font-size:10px;letter-spacing:0.14em;background:var(--tk-sev-major);color:#0a0c0e;padding:2px 7px">MAJOR</span><span class="mono-label" style="margin-left:10px">open recall / data</span></div><span style="display:inline-flex;align-items:center;gap:8px" title="CONF 1.00"><span class="mono-label" style="letter-spacing:0.12em">CONF</span><span style="display:inline-flex;gap:2px" aria-hidden="true"><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span></span><span style="font-size:13px;color:var(--tk-sev-major)">1.00</span></span></div><div style="font-size:16px;margin:14px 0 8px">Recall 20V769000: POWER TRAIN:DRIVELINE:DRIVESHAFT</div><div class="prose" style="font-size:13px;margin-bottom:14px">Honda (American Honda Motor Co.) is recalling certain 2013-2015 Accord vehicles equipped with a 4-cylinder engine and a continuously-variable transmission that were originally sold, or ever registered, in Connecticut, Delaware, District of Columbia, Illinois, Indiana, Iowa, Kentucky, Maine, Maryland, Massachusetts, Michigan, Minnesota, Missouri, New Hampshire, New Jersey, New York, Ohio, Pennsylvania, Rhode Island, Vermont, Virginia, West Virginia, and Wisconsin.  The drive shafts were assembled with a lubricant that may have degraded the drive shafts&#x27; protective coating, making it more susceptible to damage from road salt or other contaminants, and potentially cause it to break. NHTSA states the consequence: A broken drive shaft may cause a sudden loss of drive power.  The vehicle could also roll away if the parking brake has not been applied before the vehicle has been exited.  Either condition can increase the risk of a crash or injury. This campaign is on record for this model year. TIREKICK cannot tell whether it was ever carried out on this particular vehicle - NHTSA does not publish per-VIN repair status - so treat it as a question to settle, not as a defect found. Any dealer will check by VIN and perform outstanding recall work free.</div><div class="prose muted" style="font-size:12px;margin-bottom:14px"><strong style="font-weight:500">Why this confidence:</strong> Transcribed from the NHTSA recall record, not judged by a model. The certainty is that this campaign exists and covers this model year. Whether it is outstanding on this car is not something we know.</div><div style="border-top:1px solid var(--tk-line);padding-top:12px"><div class="mono-label">Evidence</div><ul style="margin:8px 0 0;padding-left:18px;font-size:12px"><li class="muted" style="margin-bottom:4px"><span style="color:var(--tk-text)">NHTSA Safety Recalls</span> / 20V769000 - NHTSA campaign 20V769000 - POWER TRAIN:DRIVELINE:DRIVESHAFT <span style="color:var(--tk-unknown)">(2026-07-26T23:31:29Z)</span></li></ul></div><div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--tk-line);font-size:12px" class="prose"><div style="margin-bottom:6px"><span class="mono-label">Ask the seller</span> Recall 20V769000 covers this model year. Has it been done on this car, and do you have the dealer paperwork?</div></div></div><div id="recall_17V418000" class="panel" style="border-left:3px solid var(--tk-sev-major);scroll-margin-top:24px"><div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center"><div><span style="font-size:10px;letter-spacing:0.14em;background:var(--tk-sev-major);color:#0a0c0e;padding:2px 7px">MAJOR</span><span class="mono-label" style="margin-left:10px">open recall / data</span></div><span style="display:inline-flex;align-items:center;gap:8px" title="CONF 1.00"><span class="mono-label" style="letter-spacing:0.12em">CONF</span><span style="display:inline-flex;gap:2px" aria-hidden="true"><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span></span><span style="font-size:13px;color:var(--tk-sev-major)">1.00</span></span></div><div style="font-size:16px;margin:14px 0 8px">Recall 17V418000: ELECTRICAL SYSTEM:12V/24V/48V BATTERY</div><div class="prose" style="font-size:13px;margin-bottom:14px">Honda (American Honda Motor Co.) is recalling certain 2013-2016 Honda Accord vehicles.  The case for the battery sensor, part of the battery management system, may allow water to get in, potentially causing an electrical short. NHTSA states the consequence: An electrical short increases the risk of a fire. This campaign is on record for this model year. TIREKICK cannot tell whether it was ever carried out on this particular vehicle - NHTSA does not publish per-VIN repair status - so treat it as a question to settle, not as a defect found. Any dealer will check by VIN and perform outstanding recall work free.</div><div class="prose muted" style="font-size:12px;margin-bottom:14px"><strong style="font-weight:500">Why this confidence:</strong> Transcribed from the NHTSA recall record, not judged by a model. The certainty is that this campaign exists and covers this model year. Whether it is outstanding on this car is not something we know.</div><div style="border-top:1px solid var(--tk-line);padding-top:12px"><div class="mono-label">Evidence</div><ul style="margin:8px 0 0;padding-left:18px;font-size:12px"><li class="muted" style="margin-bottom:4px"><span style="color:var(--tk-text)">NHTSA Safety Recalls</span> / 17V418000 - NHTSA campaign 17V418000 - ELECTRICAL SYSTEM:12V/24V/48V BATTERY <span style="color:var(--tk-unknown)">(2026-07-26T23:31:29Z)</span></li></ul></div><div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--tk-line);font-size:12px" class="prose"><div style="margin-bottom:6px"><span class="mono-label">Ask the seller</span> Recall 17V418000 covers this model year. Has it been done on this car, and do you have the dealer paperwork?</div></div></div><div id="recall_13V297000" class="panel" style="border-left:3px solid var(--tk-sev-major);scroll-margin-top:24px"><div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center"><div><span style="font-size:10px;letter-spacing:0.14em;background:var(--tk-sev-major);color:#0a0c0e;padding:2px 7px">MAJOR</span><span class="mono-label" style="margin-left:10px">open recall / data</span></div><span style="display:inline-flex;align-items:center;gap:8px" title="CONF 1.00"><span class="mono-label" style="letter-spacing:0.12em">CONF</span><span style="display:inline-flex;gap:2px" aria-hidden="true"><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span><span style="width:7px;height:12px;background:var(--tk-sev-major)"></span></span><span style="font-size:13px;color:var(--tk-sev-major)">1.00</span></span></div><div style="font-size:16px;margin:14px 0 8px">Recall 13V297000: FUEL SYSTEM, GASOLINE</div><div class="prose" style="font-size:13px;margin-bottom:14px">American Honda Motor Co., Inc. (Honda) is recalling certain model year 2013 Accord vehicles that are Low-Emission Vehicle (LEV) II rated that were manufactured January 15, 2013, through April 5, 2013.  The fuel tank neck may be out of specification causing the fuel pump to not properly seal to the fuel tank. NHTSA states the consequence: An insufficent seal may led to a fuel leak which increases the risk of a fire. This campaign is on record for this model year. TIREKICK cannot tell whether it was ever carried out on this particular vehicle - NHTSA does not publish per-VIN repair status - so treat it as a question to settle, not as a defect found. Any dealer will check by VIN and perform outstanding recall work free.</div><div class="prose muted" style="font-size:12px;margin-bottom:14px"><strong style="font-weight:500">Why this confidence:</strong> Transcribed from the NHTSA recall record, not judged by a model. The certainty is that this campaign exists and covers this model year. Whether it is outstanding on this car is not something we know.</div><div style="border-top:1px solid var(--tk-line);padding-top:12px"><div class="mono-label">Evidence</div><ul style="margin:8px 0 0;padding-left:18px;font-size:12px"><li class="muted" style="margin-bottom:4px"><span style="color:var(--tk-text)">NHTSA Safety Recalls</span> / 13V297000 - NHTSA campaign 13V297000 - FUEL SYSTEM, GASOLINE <span style="color:var(--tk-unknown)">(2026-07-26T23:31:29Z)</span></li></ul></div><div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--tk-line);font-size:12px" class="prose"><div style="margin-bottom:6px"><span class="mono-label">Ask the seller</span> Recall 13V297000 covers this model year. Has it been done on this car, and do you have the dealer paperwork?</div></div></div><div id="complaint_pattern_summary" class="panel" style="border-left:3px solid var(--tk-sev-info);scroll-margin-top:24px"><div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center"><div><span style="font-size:10px;letter-spacing:0.14em;background:var(--tk-sev-info);color:#0a0c0e;padding:2px 7px">INFO</span><span class="mono-label" style="margin-left:10px">complaint pattern / data</span></div><span style="display:inline-flex;align-items:center;gap:8px" title="CONF 1.00"><span class="mono-label" style="letter-spacing:0.12em">CONF</span><span style="display:inline-flex;gap:2px" aria-hidden="true"><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span><span style="width:7px;height:12px;background:var(--tk-sev-info)"></span></span><span style="font-size:13px;color:var(--tk-sev-info)">1.00</span></span></div><div style="font-size:16px;margin:14px 0 8px">What owners of the 2013 HONDA Accord complain about</div><div class="prose" style="font-size:13px;margin-bottom:14px">1,418 owners filed complaints with NHTSA about the 2013 HONDA Accord. The most reported areas were steering (497), electrical system (413), engine (179), unknown or other (118). This is a pattern across the model, not an observation about this car - a popular car accumulates complaints simply by being everywhere. Use it as a list of things to look at closely and ask about.</div><div class="prose muted" style="font-size:12px;margin-bottom:14px"><strong style="font-weight:500">Why this confidence:</strong> A count of public records, not a judgment. What is certain is the number of complaints filed about this model year. Nothing here is evidence about the vehicle you are looking at.</div><div style="border-top:1px solid var(--tk-line);padding-top:12px"><div class="mono-label">Evidence</div><ul style="margin:8px 0 0;padding-left:18px;font-size:12px"><li class="muted" style="margin-bottom:4px"><span style="color:var(--tk-text)">NHTSA Owner Complaints</span> / complaints/2013-HONDA-Accord - 1,418 owner complaints on file for the 2013 HONDA Accord <span style="color:var(--tk-unknown)">(2026-07-26T23:31:36Z)</span></li></ul></div><div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--tk-line);font-size:12px" class="prose"><div style="margin-bottom:6px"><span class="mono-label">Ask the seller</span> Owners of this model most often report problems with steering. Has this car had any work done there?</div><div><span class="mono-label">Ask a mechanic</span> Ask a mechanic to pay particular attention to steering on this model.</div></div></div><div id="title_hail_history_01" class="panel" style="border-left:3px solid var(--tk-sev-minor);scroll-margin-top:24px"><div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center"><div><span style="font-size:10px;letter-spacing:0.14em;background:var(--tk-sev-minor);color:#0a0c0e;padding:2px 7px">MINOR</span><span class="mono-label" style="margin-left:10px">title brand indicator / data</span></div><span style="display:inline-flex;align-items:center;gap:8px" title="CONF 1.00"><span class="mono-label" style="letter-spacing:0.12em">CONF</span><span style="display:inline-flex;gap:2px" aria-hidden="true"><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span><span style="width:7px;height:12px;background:var(--tk-sev-minor)"></span></span><span style="font-size:13px;color:var(--tk-sev-minor)">1.00</span></span></div><div style="font-size:16px;margin:14px 0 8px">Hail damage reported in your documents</div><div class="prose" style="font-size:13px;margin-bottom:14px">A document you uploaded reports hail damage. The line is quoted below exactly as it appears. Usually cosmetic, and usually reflected in the price already. TIREKICK did not query any title registry - this is a reading of your own paperwork, and paperwork can be incomplete or forged. Confirm the brand with your state&#x27;s motor vehicle agency before you buy, and price the car as branded until you have.</div><div class="prose muted" style="font-size:12px;margin-bottom:14px"><strong style="font-weight:500">Why this confidence:</strong> Exact text matching against the document you provided, not a model judgment. What is certain is that the quoted line appears in your document. Whether the document is complete, current, or genuine is not something TIREKICK can check.</div><div style="border-top:1px solid var(--tk-line);padding-top:12px"><div class="mono-label">Evidence</div><ul style="margin:8px 0 0;padding-left:18px;font-size:12px"><li class="muted" style="margin-bottom:4px"><span style="color:var(--tk-text)">history_01</span> - “2019-04 Hail damage reported to insurer. Roof and hood panels replaced.”</li></ul></div><div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--tk-line);font-size:12px" class="prose"><div style="margin-bottom:6px"><span class="mono-label">Ask the seller</span> My paperwork mentions hail damage. Can you walk me through what happened, and show me the title itself?</div><div><span class="mono-label">Ask a mechanic</span> Tell the mechanic what the paperwork says before the inspection - it changes what they look at first.</div></div></div></div></section><section class="section"><div class="section-label">Systems</div><table><thead><tr><th style="width:18%">System</th><th style="width:22%">Status</th><th>Statement</th></tr></thead><tbody><tr><td style="text-transform:uppercase;letter-spacing:0.08