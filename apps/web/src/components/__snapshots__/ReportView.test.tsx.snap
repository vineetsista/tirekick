exports[`dossier snapshot > renders the fixture report identically to the committed snapshot 1`] = `"<link rel="preload" as="image" href="/f/demo-01/photo_05.jpg"/><link rel="preload" as="image" href="/f/demo-01/photo_01.jpg"/><link rel="preload" as="image" href="/f/demo-01/photo_04.jpg"/><link rel="preload" as="image" href="/f/demo-01/photo_03.jpg"/><link rel="preload" as="image" href="/f/demo-01/photo_08.jpg"/><link rel="preload" as="image" href="/f/demo-01/photo_07.jpg"/><link rel="preload" as="image" href="/f/demo-01/photo_06.jpg"/><link rel="preload" as="image" href="/f/demo-01/photo_02.jpg"/><link rel="preload" as="image" href="/f/demo-01/video_01.frame_01.jpg"/><link rel="preload" as="image" href="/f/demo-01/video_01.frame_02.jpg"/><link rel="preload" as="image" href="/f/demo-01/video_01.frame_03.jpg"/><link rel="preload" as="image" href="/f/demo-01/video_01.frame_04.jpg"/><link rel="preload" as="image" href="/f/demo-01/video_01.frame_05.jpg"/><link rel="preload" as="image" href="/f/demo-01/audio_01.spectrogram.png"/><nav class="no-print" style="position:sticky;top:0;z-index:20;background:rgba(11,10,9,0.94);backdrop-filter:blur(8px);border-bottom:1px solid var(--tk-rule)" aria-label="Report sections"><div class="wrap" style="min-height:var(--tk-nav-h);display:flex;align-items:center;gap:var(--s-4)"><a style="text-decoration:none;flex:0 0 auto" href="/"><span style="font-weight:800;letter-spacing:0.22em;font-size:var(--t-sm)">TIREKICK</span></a><div style="display:flex;gap:var(--s-4);overflow-x:auto;flex:1 1 auto;min-width:0;scrollbar-width:none;mask-image:linear-gradient(to right, #000 calc(100% - 28px), transparent);-webkit-mask-image:linear-gradient(to right, #000 calc(100% - 28px), transparent)"><a href="#coverage" class="label" style="white-space:nowrap;text-decoration:none;padding-block:var(--s-3);color:var(--tk-graphite)">Coverage</a><a href="#verdict" class="label" style="white-space:nowrap;text-decoration:none;padding-block:var(--s-3);color:var(--tk-g